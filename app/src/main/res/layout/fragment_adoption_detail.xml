<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FB">

    <!-- 1. Vùng nội dung cuộn -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toTopOf="@id/footerActions"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <!-- Top bar: Nút back và Tiêu đề -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="24dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnBack"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    app:cardCornerRadius="23dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp"
                        android:src="@drawable/ic_back"
                        app:tint="#000000" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Chi tiết đơn"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- 2. Header Card (Màu xanh) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1D1A9B"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvDetailApplicantName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nguyễn Văn A"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetailStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_status_grey"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="Đang chờ"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:alpha="0.8"/>

                    <!-- Đã tách Label và Value cho Ngày đăng ký -->
                    <LinearLayout
                        android:id="@+id/layoutDetailRegDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvDetailApplicantName"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ngày đăng ký: "
                            android:textColor="#CCCCCC"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tvDetailRegDateValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="24/04/2026"
                            android:textColor="#CCCCCC"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/layoutDetailRegDate"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đăng ký nhận nuôi "
                            android:textColor="#CCCCCC"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tvDetailPetIdValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="900255001491282"
                            android:textColor="#B2DF20"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                    </LinearLayout>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- 3. Thông tin chi tiết -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="Thông tin chi tiết"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Hàng: Số điện thoại -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Số điện thoại: " android:textColor="#000000" android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvDetailPhoneValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1234567890" android:textColor="#333333" />
                    </LinearLayout>

                    <!-- Hàng: Email -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="4dp">
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Email: " android:textColor="#000000" android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvDetailEmailValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="tranvanA@gmail.com" android:textColor="#333333" />
                    </LinearLayout>

                    <!-- Hàng: Địa chỉ -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Địa chỉ: " android:textColor="#000000" android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvDetailAddressValue" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="24 Nguyễn Cơ Thạch, Hàm Nghi, Hà Nội" android:textColor="#333333" />
                    </LinearLayout>

                    <!-- Hàng: Loại nhà ở -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Loại nhà ở: " android:textColor="#000000" android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvDetailHouseValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chung cư" android:textColor="#333333" />
                    </LinearLayout>

                    <!-- Hàng: Kinh nghiệm -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kinh nghiệm nuôi thú cưng: " android:textColor="#000000" android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvDetailExpValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chưa" android:textColor="#333333" />
                    </LinearLayout>

                    <!-- Hàng: Trẻ em -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nhà có trẻ em không: " android:textColor="#000000" android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvDetailChildValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Không" android:textColor="#333333" />
                    </LinearLayout>

                    <!-- Hàng: Nghề nghiệp -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nghề nghiệp: " android:textColor="#000000" android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvDetailJobValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sinh viên" android:textColor="#333333" />
                    </LinearLayout>

                    <!-- Hàng: Lý do -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lý do nhận nuôi: " android:textColor="#000000" android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvDetailReasonValue" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Yêu thích động vật" android:textColor="#333333" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Lịch hẹn phỏng vấn -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:layout_marginBottom="8dp"
                android:text="Lịch hẹn phỏng vấn"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="4dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_clock" app:tint="#1D1A9B" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Thời gian: " android:textColor="#000000" android:textStyle="bold" />
                        <TextView android:id="@+id/tvDetailTimeValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="16:00" android:textColor="#333333" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="4dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_calendar" app:tint="#1D1A9B" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Ngày: " android:textColor="#000000" android:textStyle="bold" />
                        <TextView android:id="@+id/tvDetailDateValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="21/04/2026" android:textColor="#333333" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 5. Nút hành động cố định dưới đáy -->
    <LinearLayout
        android:id="@+id/footerActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F8F9FB"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRejectApplication"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Từ chối đơn"
            android:textAllCaps="false"
            android:textColor="#888888"
            app:cornerRadius="28dp"
            app:strokeColor="#CCCCCC" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmInterview"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:backgroundTint="#1D1A9B"
            android:text="Duyệt đơn"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="28dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>