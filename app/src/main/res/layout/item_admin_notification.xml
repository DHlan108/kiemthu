<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardNotification"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:layout_marginHorizontal="4dp"
    app:cardBackgroundColor="#E0E4FF"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:strokeWidth="0dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
        <ImageView android:id="@+id/imgNotifIcon" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_avatar_circle" android:backgroundTint="#1D1A9B" android:padding="12dp" android:src="@drawable/ic_wallet" app:tint="@color/white"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvNotifTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    tools:text="9:00, 17/04"
                    android:textColor="#999999"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/tvNotifTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@id/tvNotifTime"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="8dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Đơn đăng ký nhận nuôi mới!"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="15sp"/>
            </RelativeLayout>
            <TextView android:id="@+id/tvNotifContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Biến động: + 200.000vnđ\nDONATE_CH_TRANTHIB" android:textColor="#444444" android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>
    <View android:id="@+id/dotUnread" android:layout_width="10dp" android:layout_height="10dp" android:layout_gravity="top|end" android:layout_marginTop="8dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_red_dot" android:visibility="gone"/>
</com.google.android.material.card.MaterialCardView>